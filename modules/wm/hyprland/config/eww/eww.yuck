(defwindow main
           :monitor 0
           :geometry (geometry :x "0%"
                               :y "0%"
                               :width "50%"
                               :height "50%"
                               :anchor "center")
           :stacking "fg"
           :exclusive false
           :focusable false
  (topbar)
)

(defwidget topbar []
  (box :class "topbar"
    (clock)
    (workspaces)
  )
)

(defwidget clock []
  (box :class "clock"
    {formattime(EWW_TIME, "%b %m %H:%M:%S")}
  )
)

(defwidget workspaces []
  (box :class "workspaces"
    (button :class "workspace-button" "◇")
    (button :class "workspace-button" "◆")
    (button :class "workspace-button" "◇")
    (button :class "workspace-button" "◇")
    (button :class "workspace-button" "◇")
  )
)
